{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "lib": [
            "ES2022",
            "dom"
        ],
        "paths": {
            "@httptoolkit/proxy-agent": ["../custom-typings/proxy-agent.d.ts"]
        },
        "types": [
            "mocha"
        ]
    },
    "compileOnSave": true,
    "buildOnSave": true,
    "include": [
        "../custom-typings/*.d.ts",
        "**/*.ts",
    ],
    "filesGlob": [
        "../custom-typings/*.d.ts",
        "**/*.ts",
    ]
}
